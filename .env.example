# Existing public site data (keep your current values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only password for /editor. Never use a VITE_ prefix for this value.
EDITOR_PASSWORD=replace-with-a-long-random-password

# Vercel: connect a PRIVATE Blob store; Vercel supplies this server-only token.
# Local development uses .cms-data automatically instead.
BLOB_READ_WRITE_TOKEN=
# Optional: persistent storage directory for a self-hosted Node environment.
# CMS_DATA_DIR=/var/lib/hastag-cms
